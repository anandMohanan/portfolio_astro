---
import Layout from "@layouts/Layout.astro";
import Socials from "@components/Socials.astro";
---

<Layout>
  <main id="main-content" class="container">
    <header class="header">
      <div class="top-controls">
        <div class="lang-toggle" role="group" aria-label="Language switcher">
          <button type="button" class="lang-btn is-active" data-lang-switch="en" aria-pressed="true">EN</button>
          <button type="button" class="lang-btn" data-lang-switch="jp" aria-pressed="false">JP</button>
        </div>
      </div>

      <h1 class="name">Anand Mohanan</h1>
      <p class="title" data-i18n="headline">Full-Stack Engineer, AI Specialist, and QA Lead</p>
      <p class="location" data-i18n="location">Chennai, India</p>

      <div class="socials">
        <Socials />
      </div>
    </header>

    <section class="section journal-intro" lang="en">
      <h2 class="section-title">Writing</h2>
      <p>Experiments with AI, notes on building software, and entries from Niemand.</p>
      <a class="link" href="https://www.niemand.blog/">Read Niemand Journal →</a>
    </section>

    <section class="section">
      <h2 class="section-title" data-i18n="skillsTitle">Skills</h2>
      <div class="skills-grid">
        <div class="skill-category">
          <h3 class="skill-label" data-i18n="skillsLanguagesLabel">Languages</h3>
          <p class="skill-value" data-i18n="skillsLanguagesValue">JavaScript/TypeScript, Golang, Java, Python, Zig</p>
        </div>
        <div class="skill-category">
          <h3 class="skill-label" data-i18n="skillsFrontendLabel">Frontend</h3>
          <p class="skill-value" data-i18n="skillsFrontendValue">React, Next.js, TanStack, Tailwind CSS</p>
        </div>
        <div class="skill-category">
          <h3 class="skill-label" data-i18n="skillsBackendLabel">Backend</h3>
          <p class="skill-value" data-i18n="skillsBackendValue">Node.js, GraphQL, tRPC, REST APIs</p>
        </div>
        <div class="skill-category">
          <h3 class="skill-label" data-i18n="skillsAiLabel">AI / ML</h3>
          <p class="skill-value" data-i18n="skillsAiValue">LangChain, LangGraph, LlamaIndex, YOLO, OpenCV, TFLite</p>
        </div>
        <div class="skill-category">
          <h3 class="skill-label" data-i18n="skillsDbLabel">Databases</h3>
          <p class="skill-value" data-i18n="skillsDbValue">PostgreSQL, SQL, MongoDB, ClickHouse, Redis</p>
        </div>
        <div class="skill-category">
          <h3 class="skill-label" data-i18n="skillsDevopsLabel">DevOps</h3>
          <p class="skill-value" data-i18n="skillsDevopsValue">Docker, Kubernetes, CI/CD, Linux, Azure, GCP, AWS</p>
        </div>
        <div class="skill-category">
          <h3 class="skill-label" data-i18n="skillsObsLabel">Observability</h3>
          <p class="skill-value" data-i18n="skillsObsValue">Grafana, Prometheus, Langfuse, PostHog, BetterStack</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title" data-i18n="expTitle">Experience</h2>

      <div class="jobs">
        <article class="job">
          <div class="job-header">
            <h3 class="job-title" data-i18n="jobBeinexTitle">AI Specialist - Beinex</h3>
            <span class="job-meta" data-i18n="jobBeinexMeta">Jun 2026 - Present · Full-time, On-site</span>
          </div>
        </article>

        <article class="job">
          <div class="job-header">
            <h3 class="job-title" data-i18n="jobVautomateTitle">Lead Product Engineer - VAutomate AI</h3>
            <span class="job-meta" data-i18n="jobVautomateMeta">Mar 2024 - Jun 2026 · Switzerland (Remote)</span>
          </div>
          <p class="job-desc" data-i18n="jobVautomateDesc">
            Built an LLM observability SaaS from scratch using Next.js, TanStack Start, Drizzle ORM, and Better Auth.
            Designed AI agent workflows using LangChain and LangGraph, reducing LLM costs while improving output consistency.
            Integrated ClickHouse for real-time analytics dashboards. Implemented producer/consumer services for call data using
            Twilio, Vonage, Redis queues, and strict type safety. Maintained Dockerized architecture with JavaScript frontend
            and Python backend services. Built multi-environment CI/CD pipelines on Azure VMs and Blob Storage.
            Managed a Turborepo monorepo and led SEO-focused landing page development.
          </p>
        </article>

        <article class="job">
          <div class="job-header">
            <h3 class="job-title" data-i18n="jobHawksightTitle">AI Team Lead (Contract) - Hawksight</h3>
            <span class="job-meta" data-i18n="jobHawksightMeta">Jan 2025 - Jun 2026 · UK (Remote)</span>
          </div>
          <p class="job-desc" data-i18n="jobHawksightDesc">
            Built and deployed custom YOLO models for PPE compliance and driver drowsiness detection.
            Integrated AI models into Android applications using Java and Kotlin.
            Implemented real-time alerting systems for anomaly detection in production environments.
            Deployed AI solutions on edge hardware for real-time inference.
            Developed face recognition functionality for surveillance workflows.
            Represented the product at Expand North Star (Dubai) and EXCON 2025 (Bangalore).
            Leading UAE expansion, integrating AI solutions with IP4 camera systems.
          </p>
        </article>

        <article class="job">
          <div class="job-header">
            <h3 class="job-title" data-i18n="jobBitbridgeTitle">Software Developer (Contract) - Bitbridge</h3>
            <span class="job-meta" data-i18n="jobBitbridgeMeta">Jan 2025 - Jun 2026 · Japan / Trivandrum (Remote)</span>
          </div>
          <p class="job-desc" data-i18n="jobBitbridgeDesc">
            Built a custom video conferencing and chat platform for a healthcare company using Kurento.
            Maintained and enhanced MVC-based Java backend services for messaging and video streaming.
            Developed UI components in vanilla JavaScript and resolved production bugs.
            Implemented system observability using Grafana dashboards and Prometheus metrics.
            Integrated OpenCV and TFLite models into an Android application for driver drowsiness detection.
            Trained and deployed YOLOv5 models from custom datasets.
          </p>
        </article>

        <article class="job">
          <div class="job-header">
            <h3 class="job-title" data-i18n="jobVrarriTitle">Software Developer & QA Lead (Contract) - Vrarri</h3>
            <span class="job-meta" data-i18n="jobVrarriMeta">Mar 2025 - Jun 2026 · Japan (Remote)</span>
          </div>
          <p class="job-desc" data-i18n="jobVrarriDesc">
            Built user onboarding, staff management, and reservation applications for VR attraction stores in Japan.
            Developed a Stripe-integrated reservation system and a full-featured admin dashboard.
            Implemented VR game deployment using Unity WebGL.
            Built a VR training dashboard using React, Firebase, and GCP Cloud Functions.
            Migrated a legacy React app to Next.js for a real-time translation platform.
            Built a Mediasoup server integrated with a Next.js frontend for live VR streaming.
            Automated CI/CD pipelines and managed Firebase, AWS, and Vercel deployments.
            Also managing end-to-end QA across releases, regression coverage, and production readiness.
          </p>
        </article>

        <article class="job">
          <div class="job-header">
            <h3 class="job-title" data-i18n="jobFreelanceTitle">Freelance Software Consultant</h3>
            <span class="job-meta" data-i18n="jobFreelanceMeta">Mar 2024 - Jun 2026</span>
          </div>
          <p class="job-desc" data-i18n="jobFreelanceDesc">
            Built Web3 application Banyangrow. Developed UI components for an American TV service provider.
            Improved SEO, fixed production bugs, and shipped new features for live systems.
            Maintained and enhanced a legacy real estate platform (HomeKonnect).
          </p>
        </article>

        <article class="job">
          <div class="job-header">
            <h3 class="job-title" data-i18n="jobAvasoftTitle">Software Engineer - Avasoft</h3>
            <span class="job-meta" data-i18n="jobAvasoftMeta">Feb 2023 - Feb 2024 · Chennai</span>
          </div>
          <p class="job-desc" data-i18n="jobAvasoftDesc">
            Performed root cause analysis for production incidents, reducing resolution time.
            Wrote and executed data scripts to fix production data inconsistencies.
            Delivered client-requested enhancements with a focus on stability and performance.
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title" data-i18n="projectsTitle">Things I've built</h2>
      <div class="projects">
        <article class="project">
          <div class="project-heading"><h3 class="project-name"><a href="https://github.com/anandMohanan/glint">Glint</a></h3><span class="project-language">Gleam</span></div>
          <p class="project-desc" data-i18n="projectGlint">A Redis-inspired key-value store running on the BEAM.</p>
        </article>
        <article class="project">
          <div class="project-heading"><h3 class="project-name"><a href="https://github.com/anandMohanan/prismix">Prismix</a></h3><span class="project-language">Gleam</span></div>
          <p class="project-desc" data-i18n="projectPrismix">A reverse proxy with load balancing, health checks, and retries.</p>
        </article>
        <article class="project">
          <div class="project-heading"><h3 class="project-name"><a href="https://github.com/anandMohanan/interpreter_in_rust">interpreter_in_rust</a></h3><span class="project-language">Rust</span></div>
          <p class="project-desc" data-i18n="projectInterpreter">An interpreter experiment with a lexer, parser, and a small REPL.</p>
        </article>
        <article class="project">
          <div class="project-heading"><h3 class="project-name"><a href="https://github.com/anandMohanan/syfetch">syfetch</a></h3><span class="project-language">Rust</span></div>
          <p class="project-desc" data-i18n="projectSyfetch">A terminal tool for checking system information.</p>
        </article>
      </div>
      <p class="github-more"><a href="https://github.com/anandMohanan?tab=repositories" data-i18n="moreProjects">More on GitHub →</a></p>
    </section>

    <section class="section">
      <h2 class="section-title" data-i18n="certTitle">Certifications</h2>
      <ul class="certifications">
        <li class="certificate" lang="en">
          <a href="https://credential.nvidia.com/6b579117-84b4-4dc6-b289-5e46a72bb65f">NVIDIA-Certified Professional: Agentic AI</a>
          <span class="credential-meta">NVIDIA · Issued Oct 2026, expires Oct 2028</span>
          <span class="credential-meta">Credential ID 197507626</span>
        </li>
        <li class="certificate" lang="en">
          <a href="https://badgecert.com/bc/html/profile.jsp?k=vwhfjyu">Certified Scrum Product Owner (CSPO)</a>
          <span class="credential-meta">Scrum Alliance · Issued Jun 2026, expires Jun 2028</span>
          <span class="credential-meta">Credential ID 001681589</span>
        </li>
        <li class="certificate" lang="en">
          <a href="https://app.badgecert.com/public/badges/erncfedj" data-i18n="cert1">Certified ScrumMaster®</a>
          <span class="credential-meta">Scrum Alliance · Issued Sep 2024, expires Jun 2028</span>
          <span class="credential-meta">Credential ID 1991166</span>
        </li>
        <li data-i18n="cert2">Generative AI Fundamentals - Databricks</li>
        <li data-i18n="cert3">Graph Developer (Professional & Associate) - Apollo GraphQL</li>
        <li data-i18n="cert4">SQL for Data Analytics - Udemy</li>
        <li data-i18n="cert5">Introduction to Data Science - Coursera</li>
        <li data-i18n="cert6">Salesforce Trailhead Superbadges</li>
      </ul>
    </section>

    <section class="section">
      <h2 class="section-title" data-i18n="connectTitle">Connect</h2>
      <p class="more-links"><a href="/about/">About</a> / <a href="/tools/">Tools</a></p>
      <p class="connect-text">
        <span data-i18n="connectLead">Currently an AI Specialist at Beinex. Always happy to talk about AI and software.</span>
        <a href="https://www.linkedin.com/in/anand-mohanan" class="link" data-i18n="connectCta">Say hello</a>
      </p>
    </section>


  </main>
</Layout>

<style>
  .more-links { font-size: .8125rem; color: var(--text-dim); margin-bottom: 1rem; }
  .journal-intro p { color: var(--text-dim); margin-bottom: .5rem; }
  .container {
    max-width: 680px;
    margin: 0 auto;
    width: 100%;
    padding: 0 1.5rem;
  }

  .header {
    position: relative;
    margin-bottom: 3rem;
  }

  .top-controls { position: absolute; right: 0; top: 4px; }
  .lang-toggle { display: flex; gap: .8rem; }
  .lang-btn { font-family: "Commit Mono", monospace; border: 0; background: transparent; color: var(--text-dim); font-size: .75rem; padding: .25rem 0; cursor: pointer; }
  .lang-btn.is-active { color: var(--text); text-decoration: underline; text-underline-offset: 5px; }
  .name {
    padding-right: 90px;
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 1rem;
    opacity: 85%;
    margin-bottom: 0.25rem;
  }

  .location {
    font-size: 1rem;
    opacity: 60%;
    margin-bottom: 1.5rem;
  }

  .socials {
    margin-top: 1rem;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .section {
    margin-bottom: 4rem;
    padding: 0;
  }

  .section:nth-child(2) { animation-delay: 0.1s; }
  .section:nth-child(3) { animation-delay: 0.2s; }
  .section:nth-child(4) { animation-delay: 0.3s; }
  .section:nth-child(5) { animation-delay: 0.4s; }
  .section:nth-child(6) { animation-delay: 0.5s; }
  .section:nth-child(7) { animation-delay: 0.6s; }

  .section-title {
    font-family: "Commit Mono", monospace;
    font-size: 0.625rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
  }

  .skills-grid {
    display: grid;
    gap: 1.25rem;
  }

  .skill-category {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
    padding: 0.5rem 0.75rem;
    margin: -0.5rem -0.75rem;
    border-radius: 8px;
    transition: background-color 180ms ease-out, transform 180ms ease-out;
  }

  .skill-category:hover {
    background-color: rgba(var(--color-border), 0.3);

  }

  .skill-label {
    font-size: 1rem;
    font-weight: 500;
    opacity: 70%;
  }

  .skill-value {
    font-size: 1rem;
    opacity: 80%;
  }

  .jobs {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .job {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgb(var(--color-border));
    transition: opacity 180ms ease-out, transform 180ms ease-out;
  }

  .job:hover {
    opacity: 1;

  }

  .job:last-child {
    border-bottom: none;
  }

  .job-header {
    margin-bottom: 0.75rem;
  }

  .job-title {
    font-size: 1.0625rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .job-meta {
    font-family: "Commit Mono", monospace;
    font-size: 0.625rem;
    opacity: 60%;
  }

  .job-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 80%;
  }

  .github-more { margin-top: 1.5rem; font-size: .75rem; color: var(--text-dim); }
  .project-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: .75rem; }
  .project-language { font-size: .625rem; color: var(--text-dim); }
  .projects {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-name {
    font-size: 1rem;
    font-weight: 500;
  }

  .project-name a {
    color: inherit;
    text-decoration: none;
    position: relative;
    display: inline-block;
  }

  .project-name a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 200ms ease-out;
  }

  .project-name a:hover::after {
    width: 100%;
  }

  .project-desc {
    font-size: 0.875rem;
    opacity: 70%;
  }

  .credential-meta { display: block; font-family: "Commit Mono", monospace; font-size: .625rem; color: var(--text-dim); margin-top: .3rem; }
  .certificate { margin-bottom: .75rem; }
  .certifications {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .certifications li {
    font-size: .9375rem;
    opacity: 80%;
    padding-left: 1.25rem;
    position: relative;
    transition: padding-left 180ms ease-out, opacity 180ms ease-out;
  }

  .certifications li:hover {
    padding-left: 1.5rem;
    opacity: 1;
  }

  .certifications li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--text-dim);
  }

  .connect-text {
    font-size: 1.125rem;
    line-height: 1.6;
    opacity: 85%;
  }

  .link {
    color: rgb(var(--color-text-base));
    text-decoration: underline;
    text-underline-offset: 3px;
    margin: 0 0.35rem;
  }

  .link:hover {
    opacity: 70%;
  }

  .footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-border));
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 1.5rem;
    }

    .name {
      font-size: 1.625rem;
    }

    .skill-category {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>

