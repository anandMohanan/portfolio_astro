---
import { SITE } from "src/config";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout description={frontmatter.description} title={`${frontmatter.title} | ${SITE.title}`}>
  <main id="main-content">
    <section id="about" class="prose prose-img:border-0">
      <h1 class="text-2xl sm:text-3xl tracking-wider">{frontmatter.title}</h1>
      <slot />
    </section>
  </main>

</Layout>

<style>
#main-content { width: 100%; max-width: 680px; margin: 0 auto; padding: 0 24px; }
#about { padding: 0; }
</style>
