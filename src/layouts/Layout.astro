---
import { SITE } from "src/config";
import "../styles/base.css";
import "../styles/site.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

export interface Props {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "Anand Mohanan | Full-Stack Engineer & AI Specialist",
  author = SITE.author,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname.replace(/\/?$/, "/"), SITE.website);

const socialImageURL = new URL(
  ogImage ? ogImage : SITE.ogImage,
  SITE.website
).href;

const fallbackImageURL = new URL(SITE.ogImage, SITE.website).href;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href="/fonts/commit-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->

    <!-- <link rel="icon" href="/blob.svg" type="image/icon type" /> -->
    
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={socialImageURL.endsWith(".svg")
        ? fallbackImageURL
        : socialImageURL}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anand Mohanan" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="alternate" type="application/rss+xml" title="Niemand Journal" href="https://www.niemand.blog/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Person', '@id': `${SITE.website}#person`,
      name: SITE.author, url: SITE.website, jobTitle: 'AI Specialist',
      worksFor: { '@type': 'Organization', name: 'Beinex' },
      sameAs: ['https://github.com/anandMohanan', 'https://www.linkedin.com/in/anand-mohanan/'],
      subjectOf: { '@type': 'Blog', url: 'https://www.niemand.blog/', name: 'Niemand Journal' }
    }).replace(/</g, "\u003c")} />
    <script is:inline src="/toggle-theme.js"></script>
  </head>
  <body>
    <SiteHeader area="portfolio" />
    <slot />
    <SiteFooter />
  </body>
</html>
